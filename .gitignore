# Node
node_modules/
npm-debug.log*
.npm/

# Local scratch: capture dumps, calibration exports, ad-hoc probes
*.log
*.tmp
tmp/
scratch/
probe-*.html

# Arduino: the --build-path directory the ESP32-S3 flash flow writes
build/
.build/

# WLED upstream clone + PlatformIO output (firmware/wled-custom/setup.sh clones it)
firmware/wled/
firmware/wled-custom/*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.wall-profile/
.bsl-test/
.wall-electron/

# User drawing entries (the wall gallery): local data, not source
data/

# The relay's own local data (gallery, wall key, owner token) when run outside
# a container. The keys in here pair the wall: never commit them.
relay/data/

# local credentials (SSH etc) - never commit
.env

# electron-builder output: rebuilt per version, never source
dist/
