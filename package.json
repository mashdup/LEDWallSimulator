{
  "name": "led-wall-simulator",
  "version": "0.11.3",
  "private": true,
  "author": "hoa.family <wall@hoa.family>",
  "homepage": "https://github.com/mashdup/LEDWallSimulator",
  "type": "module",
  "main": "tools/electron/main.cjs",
  "description": "1m^2 APA106/PL9823 curtain wall: browser is the brain, ESP32 is a dumb pixel sink.",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"test/*.test.js\"",
    "serve": "node tools/serve.js",
    "start": "node tools/start.js",
    "wall": "node tools/start.js --electron",
    "freeport": "node tools/freeport.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "family.hoa.ledwall",
    "productName": "LED Wall",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "package.json",
      "tools/**",
      "core/**",
      "web/**",
      "!tools/start.js",
      "!**/node_modules/serialport/**",
      "!**/node_modules/@serialport/**",
      "!**/node_modules/node-gyp-build/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "tools/electron/entitlements.mac.plist",
      "entitlementsInherit": "tools/electron/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility"
    }
  }
}
